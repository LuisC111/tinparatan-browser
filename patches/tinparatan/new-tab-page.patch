+
+  /**
+   * Hardcoded new-tab query. DuckDuckGo is Helium's default engine. A later
+   * version should read the profile search engine, and the wordmark below the
+   * logo, from a preference passed through loadTimeData.
+   */
+  protected onTinparatanSearchKeydown_(event: KeyboardEvent) {
+    if (event.key !== 'Enter') {
+      return;
+    }
+    const query = (event.target as HTMLInputElement).value.trim();
+    if (!query) {
+      return;
+    }
+    WindowProxy.getInstance().navigate(this.tinparatanDestinationForQuery_(query));
+  }
+
+  private tinparatanDestinationForQuery_(query: string): string {
+    if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(query)) {
+      return query;
+    }
+    const looksLikeHost =
+        /^(localhost(:\d+)?([/?#].*)?|[\w.-]+\.[a-zA-Z]{2,}([/?#].*)?)$/
+            .test(query) &&
+        !query.includes(' ');
+    if (looksLikeHost) {
+      return `https://${query}`;
+    }
+    return 'https://duckduckgo.com/?q=' + encodeURIComponent(query);
+  }
 }
 
