+
+/* Tinparatan new-tab hero. Colors follow the NTP foreground so the wordmark
+   stays readable on light themes and on dark or image backgrounds. */
+#tinparatanHero {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  margin-bottom: 8px;
+  user-select: none;
+}
+
+#tinparatanLogo {
+  height: auto;
+  margin-bottom: 18px;
+  width: 132px;
+}
+
+#tinparatanWordmark {
+  color: var(--color-new-tab-page-most-visited-foreground, #fff);
+  font-family: "Cascadia Mono", "Cascadia Code", Consolas, "Liberation Mono",
+      ui-monospace, monospace;
+  font-size: 40px;
+  font-weight: 700;
+  letter-spacing: 0;
+  line-height: 1;
+}
+
+#tinparatanWordmark .prompt,
+#tinparatanWordmark .cursor {
+  color: #ff2b2b;
+}
+
+#tinparatanWordmark .cursor {
+  animation: tinparatan-cursor 1.05s steps(1) infinite;
+}
+
+@keyframes tinparatan-cursor {
+  50% {
+    opacity: 0;
+  }
+}
+
+#tinparatanSearch {
+  appearance: none;
+  background: color-mix(
+      in srgb,
+      var(--color-new-tab-page-most-visited-foreground, #fff) 8%,
+      transparent);
+  border: 1px solid color-mix(
+      in srgb,
+      var(--color-new-tab-page-most-visited-foreground, #fff) 22%,
+      transparent);
+  border-radius: 999px;
+  box-sizing: border-box;
+  color: var(--color-new-tab-page-most-visited-foreground, #fff);
+  font-family: inherit;
+  font-size: 15px;
+  height: 44px;
+  margin-top: 26px;
+  outline: none;
+  padding: 0 20px;
+  user-select: text;
+  width: min(640px, 78vw);
+}
+
+#tinparatanSearch::placeholder {
+  color: color-mix(
+      in srgb,
+      var(--color-new-tab-page-most-visited-foreground, #fff) 55%,
+      transparent);
+}
+
+#tinparatanSearch:focus {
+  border-color: color-mix(in srgb, #ff2b2b 70%, transparent);
+}
